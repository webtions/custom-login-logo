{
	"name": "webtions/custom-login-logo",
	"type": "wordpress-plugin",
	"description": "Easily add a custom logo to your WordPress login page using the built-in media uploader.",
	"keywords": ["WordPress", "plugin", "login", "logo"],
	"homepage": "https://github.com/webtions/custom-login-logo",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"wp-coding-standards/wpcs": "^3.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.8",
		"php-stubs/wordpress-tests-stubs": "^6.8",
		"phpstan/extension-installer": "^1.4",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"scripts": {
		"lint": "parallel-lint -p php --exclude vendor .",
		"standards:check": "phpcs",
		"standards:fix": "phpcbf",
		"analyze": "phpstan analyze --memory-limit=512M"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
